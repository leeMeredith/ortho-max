# Generated by CMake. Contains absolute paths baked in at configure time, so it
# is never portable between machines or even between folder locations. Always
# regenerate rather than committing or hand-fixing it.
build/

# Build output. The .mxo is produced by every build; users build their own.
externals/

# macOS
.DS_Store

# Xcode user state, if anyone opens the generated project in the IDE
*.xcuserdatad/
xcuserdata/
